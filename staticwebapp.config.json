{
  "routes": [
    {
      "route": "/api/*",
      "allowedRoles": ["authenticated"]
    },
    {
      "route": "/.auth/login/github",
      "statusCode": 200
    },
    {
      "route": "/.auth/login/aad",
      "statusCode": 200
    },
    {
      "route": "/.auth/logout",
      "statusCode": 200
    }
  ],
  "responseOverrides": {
    "401": {
      "statusCode": 302,
      "redirect": "/.auth/login/github"
    }
  },
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": ["/api/*", "/icons/*", "*.css", "*.js", "*.png", "*.svg", "*.webmanifest"]
  }
}
